<idea-plugin>
    <dependencies>
        <module name="com.falsepattern.zigbrains.shared"/>
        <module name="intellij.platform.ui.jcef"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                factoryClass="com.falsepattern.zigbrains.project.webui.ZigWebUiToolWindowFactory"
                anchor="right"
                icon="com.falsepattern.zigbrains.Icons.Zig"
                id="Zig Web UI"
                canCloseContents="true"
                doNotActivateOnStart="true"
        />
        <notificationGroup
                id="zigbrains-webui"
                displayType="BALLOON"
                bundle="zigbrains.webui.Bundle"
                key="notification.group.zigbrains-webui"
        />
    </extensions>

    <projectListeners>
        <listener
                class="com.falsepattern.zigbrains.project.webui.ZigWebUiExecutionListener"
                topic="com.intellij.execution.ExecutionListener"
        />
    </projectListeners>
</idea-plugin>
