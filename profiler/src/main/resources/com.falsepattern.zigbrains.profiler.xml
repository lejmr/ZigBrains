<idea-plugin>
    <dependencies>
        <module name="com.falsepattern.zigbrains.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                factoryClass="com.falsepattern.zigbrains.profiler.ZigProfilerToolWindowFactory"
                anchor="bottom"
                icon="com.falsepattern.zigbrains.Icons.Zig"
                id="Zig Profiler"
                canCloseContents="true"
                doNotActivateOnStart="true"
        />
        <runLineMarkerContributor
                language="Zig"
                implementationClass="com.falsepattern.zigbrains.profiler.ZigProfileLineMarker"
        />
        <executor implementation="com.falsepattern.zigbrains.profiler.ZigProfileExecutor"/>
        <programRunner implementation="com.falsepattern.zigbrains.profiler.ZigProfilerProgramRunner"/>
    </extensions>
</idea-plugin>
